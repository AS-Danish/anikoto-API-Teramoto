# Production streaming proxy. Keep this server-side; clients receive signed URLs.
CF_WORKER_URL=https://aonime-proxy.luffytv.workers.dev
PROXY_SIGNING_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PROXY_URL_TTL_SECONDS=7200
APPROVED_STREAM_HOSTS=cdn.watching.onl,*.watching.onl,s1.akirax.buzz,*.akirax.buzz,*.mewstream.buzz,*.zaplume.buzz,*.megaplay.buzz,*.megacloud.tv,*.gogocdn.net,*.gogoplay4.com,*.vidstreaming.io,*.vidcloud9.com,*.embtaku.pro
BASE_URL=https://anikototv.to
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://replace-with-your-luffy-tv-domain.example

# Required to use ?refresh=1. Send it in x-cache-refresh-token; never expose it
# in a browser or mobile build.
CACHE_REFRESH_SECRET=replace-with-a-long-random-secret

# Recommended for multi-instance/serverless production deployments. Without
# these values the API safely falls back to its bounded per-instance cache.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-server-only-token
CACHE_NAMESPACE=luffytv:local:v1

# Hard ceiling for source-site traffic. When Redis is configured the RPS budget
# is shared across every API instance; concurrency is also capped per instance.
UPSTREAM_REQUESTS_PER_SECOND=8
UPSTREAM_MAX_CONCURRENCY=6

# Waterfall API fallback URLs
SHINEII_URL=http://127.0.0.1:4444
CONSUMET_URL=https://api.consumet.org/anime/gogoanime
GOGO_URL=https://api.consumet.org/anime/gogoanime

# Compulsory Android sideload release. Upload the APK before publishing these.

ANDROID_VERSION=1.0.2
ANDROID_VERSION_CODE=2
ANDROID_APK_URL=https://github.com/AS-Danish/luffytv-releases/releases/download/v1.0.2/luffytv-1.0.2-build2.apk
ANDROID_APK_SHA256=4600e7559c94ef55a2fd4236af26cce961f8f25d04280b4ab685924cfdfa5509
ANDROID_APK_SIZE=287832793
ANDROID_PUBLISHED_AT=2026-08-25T17:13:56.6080912Z

ANDROID_UPDATE_TITLE=Luffy TV 1.0.2 is required
ANDROID_UPDATE_MESSAGE=Update Luffy TV to continue streaming. Your downloaded episodes remain available offline.
ANDROID_CHANGELOG=Improved image quality and caching|Faster preview thumbnails|Fixed episode downloads|Improved video source reliability|Player and stability improvements